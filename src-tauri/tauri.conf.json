{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rachayitha",
  "version": "1.0.0",
  "identifier": "com.ramaputhra.rachayitha",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "రచయిత - Rachayitha Settings & Playground",
        "width": 840,
        "height": 650,
        "resizable": true,
        "visible": false,
        "center": true,
        "transparent": false,
        "decorations": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "tooltip": "Rachayitha: Telugu Transliteration (Alt+T)"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Real-time Telugu phonetic transliteration for any desktop app",
    "longDescription": "Rachayitha allows you to type in Tenglish and converts it to native Telugu script in real-time across Windows, macOS, and Linux.",
    "category": "Utility",
    "copyright": "Copyright 2026 Ramaputhra / Rachayitha"
  }
}
